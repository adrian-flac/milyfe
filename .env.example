# URL usada por la aplicación en ejecución: rol sin permisos de DDL y TLS obligatorio.
DATABASE_URL="postgresql://APP_USER:APP_PASSWORD@DB_HOST:5432/milyfe?sslmode=require"

# URL usada solamente por Prisma durante las migraciones: rol con permisos de DDL.
# No la configures como variable normal de Vercel: aplica migraciones desde una
# terminal controlada o CI con un secreto exclusivo del paso de migración.
DIRECT_URL="postgresql://MIGRATOR_USER:MIGRATOR_PASSWORD@DB_HOST:5432/milyfe?sslmode=require"

# Genera un valor aleatorio de al menos 32 bytes. Debe mantenerse estable entre despliegues.
AUTH_SECRET="REPLACE_WITH_A_RANDOM_SECRET"

# Vercel reconoce su host de forma segura automáticamente. En otro hosting, actívalo
# solo si tu proxy de confianza reemplaza Host/X-Forwarded-Host con el dominio público.
# AUTH_TRUST_HOST="true"

APP_OWNER_EMAIL="owner@example.com"
ALLOW_REGISTRATION="false"

# Añádalo únicamente al activar una instalación nueva y elimínalo justo después.
# BOOTSTRAP_TOKEN="REPLACE_WITH_A_ONE_TIME_RANDOM_TOKEN"
