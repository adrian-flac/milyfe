#!/usr/bin/env bash
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")"

if ! command -v node >/dev/null 2>&1; then
  codex_node_bin="$HOME/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin"
  if [[ ! -x "$codex_node_bin/node" ]]; then
    printf 'Instala Node.js antes de iniciar Milyfe. Consulta .nvmrc.\n' >&2
    exit 1
  fi
  export PATH="$codex_node_bin:$PATH"
fi

pnpm_version="$(node -p "require('./package.json').packageManager.split('@')[1]")"
local_pnpm="${XDG_DATA_HOME:-$HOME/.local/share}/milyfe-tools/pnpm-$pnpm_version/bin/pnpm.cjs"
if [[ -f "$local_pnpm" ]]; then
  pnpm_cmd=(node "$local_pnpm")
elif command -v pnpm >/dev/null 2>&1 && [[ "$(pnpm --version)" == "$pnpm_version" ]]; then
  pnpm_cmd=(pnpm)
else
  printf 'Instala pnpm %s antes de iniciar Milyfe.\n' "$pnpm_version" >&2
  exit 1
fi

if [[ ! -f .env && -z "${DATABASE_URL:-}" ]]; then
  printf 'Configura DATABASE_URL y AUTH_SECRET en el archivo .env.\n' >&2
  exit 1
fi

if [[ ! -x node_modules/.bin/next ]]; then
  "${pnpm_cmd[@]}" install --frozen-lockfile
fi

if [[ ! -f generated/prisma/client.ts ]]; then
  "${pnpm_cmd[@]}" db:generate
fi

exec "${pnpm_cmd[@]}" dev --hostname localhost "$@"
