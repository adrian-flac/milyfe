{
  "name": "milyfe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:verify": "node scripts/verify-db.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc --ignoreConfig --noEmit false --outDir .test-build --target ES2022 --module Node16 --moduleResolution Node16 lib/dates.ts lib/habit-progress.ts lib/auth-rate-limit-core.ts lib/password-policy.ts lib/request-security.ts && node --test tests/dates-and-habits.test.cjs tests/auth-rate-limit.test.cjs tests/security-helpers.test.cjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "dotenv": "^17.2.3",
    "prisma": "7.10.1",
    "typescript": "latest"
  },
  "packageManager": "pnpm@10.26.0",
  "pnpm": {
    "overrides": {
      "lodash": "4.18.1"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
